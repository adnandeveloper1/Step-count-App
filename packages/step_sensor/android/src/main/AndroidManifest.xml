<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Activity Recognition before Android 10, granted at install. Android 10+
         uses the app's Physical activity permission. -->
    <uses-permission
        android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION"
        android:maxSdkVersion="28" />

    <application>
        <!-- Vehicle transitions from Play Services (see DriveDetector). -->
        <receiver
            android:name="com.nexappra.stepsensor.DriveTransitionReceiver"
            android:exported="false" />
    </application>
</manifest>
